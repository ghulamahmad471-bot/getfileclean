# Keep source files private; only the built site is public.
<FilesMatch "\.(py|txt|md)$">
  Require all denied
</FilesMatch>
<Files "robots.txt">
  Require all granted
</Files>
RedirectMatch 404 ^/(posts|\.git|\.github)(/|$)

# Pretty URLs: /blog/my-post instead of /blog/my-post.html
RewriteEngine On
# Old links to index.html -> folder (301)
RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
# Old links ending in .html -> same address without .html (301)
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
# Serve /page from page.html behind the scenes
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
